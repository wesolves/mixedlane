# Mixedlane web container: serves the built UI and reverse-proxies the API (REST, realtime socket,
# MCP endpoint, OAuth discovery, uploads) so everything is on one origin.
# ${API_UPSTREAM} is filled in from the environment by the nginx image at startup.

# Behind another TLS proxy (Caddy, Traefik, a cloud LB) keep its X-Forwarded-Proto; otherwise use ours.
map $http_x_forwarded_proto $fwd_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

# Keep-alive to the API, and a clean Connection header for normal requests.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      "";
}

upstream mixedlane_api {
  server ${API_UPSTREAM};
  keepalive 32;
}

server {
  listen 8080;
  server_name _;
  server_tokens off;

  root /usr/share/nginx/html;
  index index.html;

  # Videos can be up to 200 MB.
  client_max_body_size 210m;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # ---- API, MCP, OAuth discovery ----
  location /api/ {
    proxy_pass http://mixedlane_api;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Upgrade $http_upgrade;
    # Stream uploads, MCP responses and downloads instead of buffering them.
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  # Realtime socket: long-lived WebSocket connections.
  location /api/socket/ {
    proxy_pass http://mixedlane_api;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  location /.well-known/ {
    proxy_pass http://mixedlane_api;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # ---- Web app ----
  # Hashed build assets never change.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Everything else is the single-page app; index.html is never cached so deploys apply at once.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
