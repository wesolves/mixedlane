{
  "name": "flowboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:lan": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web -- --host 0.0.0.0\"",
    "dev:api": "cd apps/server && node --watch-path=src --watch-path=../../packages/shared/src --enable-source-maps --import @swc-node/register/esm-register src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "start:api": "cd apps/server && node --enable-source-maps --import @swc-node/register/esm-register src/main.ts",
    "build": "npm run build:web && npm run build:server",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "seed:reset": "node -e \"fetch('http://localhost:3001/api/dev/reset-demo',{method:'POST'}).then(r=>r.json()).then(console.log,e=>{console.error('Is the dev server running? '+e.message);process.exit(1)})\"",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server --noEmit && tsc -p apps/web",
    "db:generate": "cd apps/server && drizzle-kit generate",
    "test:api": "cd apps/server && vitest run",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --enable-source-maps build/apps/server/src/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/websockets": "^11.2.6",
    "@tanstack/react-query": "^5.62.8",
    "@tiptap/extension-code-block-lowlight": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.11.0",
    "@tiptap/extension-mention": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/extension-table": "^2.27.3",
