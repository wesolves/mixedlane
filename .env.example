# ---- Database: external PostgreSQL (default) or bundled PostgreSQL ----
# Default: set DATABASE_URL and run docker compose up -d --build.
# Create the database first. Use your provider's TLS options and percent-encode URL credentials.
# DATABASE_URL=postgresql://mixedlane:encoded-password@db.example.com:5432/mixedlane?sslmode=verify-full
DATABASE_URL=
# Bundled: set POSTGRES_PASSWORD and run docker compose -f docker-compose.db.yml up -d --build.
# DATABASE_URL is ignored by the bundled stack. Use a URL-safe password (e.g. hex) below.
# Changing this does not reset an existing pgdata volume's password.
POSTGRES_PASSWORD=change-me

# ---- Secrets ----
# Optional in Docker: left empty, they're generated on first start and kept in the api's /data volume.
# To set them yourself (64 hex chars each):  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SECRET_KEY=

# Public address people use to open Mixedlane (links in emails, OAuth, plugins; https:// enables Secure cookies + HSTS)
APP_URL=http://localhost:3000
# Public address of the API for GitHub webhooks (usually the same as APP_URL)
PUBLIC_URL=

# ---- Email (leave MAIL_HOST empty to disable delivery and auto-verify new signups) ----
MAIL_HOST=
MAIL_PORT=465
# SMTP login supplied by your provider; often the full mailbox address, e.g. support@wesolves.in.
MAIL_USERNAME=
MAIL_PASSWORD=
# Default false. For standard port 465 use true; for port 587/STARTTLS use false.
MAIL_SSL=false
MAIL_FROM=Mixedlane <no-reply@example.com>

# ---- Networking ----
# Port the web container is published on (the whole app: UI, API, MCP, realtime)
HOST_PORT=3000
# Proxy hops in front of the api: 1 = the bundled nginx (docker compose default); 2 if you add a TLS proxy in front
# TRUST_PROXY=1
# Requests per minute per client (API key or IP), and per IP on login/registration
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=20

# ---- Uploads: local volume (default) or S3-compatible ----
STORAGE_DRIVER=local
# With `--profile s3` the bundled MinIO is used:
# STORAGE_DRIVER=s3
# S3_BUCKET=mixedlane
# S3_ENDPOINT=http://minio:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=mixedlane
# S3_SECRET_ACCESS_KEY=mixedlane-secret
# For AWS S3, set S3_BUCKET and S3_REGION (credentials from env or an instance role).
S3_REGION=us-east-1
